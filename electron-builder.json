{
    "appId": "org.meshy.client",
    "productName": "Meshy",
    "directories": { "output": "dist" },
    "files": ["out/**/*", "icon.png", "package.json", "LICENSE"],
    "asarUnpack": ["**/*.node"],
    "icon": ".build-resources/icon.png",
    "publish": [{ "provider": "github", "owner": "leandrolsouza", "repo": "meshy-torrent" }],
    "protocols": [{ "name": "BitTorrent magnet", "schemes": ["magnet"] }],
    "fileAssociations": [
        {
            "ext": "torrent",
            "name": "BitTorrent torrent",
            "description": "BitTorrent metadata",
            "mimeType": "application/x-bittorrent",
            "role": "Viewer"
        }
    ],
    "win": {
        "target": [{ "target": "nsis", "arch": ["x64"] }],
        "verifyUpdateCodeSignature": true
    },
    "nsis": {
        "oneClick": false,
        "perMachine": false,
        "allowToChangeInstallationDirectory": true,
        "artifactName": "${productName}-${version}-win-${arch}-setup.${ext}"
    },
    "mac": { "target": "dmg", "category": "public.app-category.utilities" },
    "linux": {
        "target": ["deb", "AppImage"],
        "category": "Network",
        "mimeTypes": ["application/x-bittorrent", "x-scheme-handler/magnet"]
    }
}
