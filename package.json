{
    "name": "meshy",
    "version": "0.1.0-beta.10",
    "description": "Meshy Torrent — cliente torrent desktop multiplataforma",
    "main": "out/main/index.mjs",
    "scripts": {
        "dev": "electron-vite dev",
        "build": "electron-vite build",
        "preview": "electron-vite preview",
        "start": "electron .",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.jest.json",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "pack": "npm run build && node scripts/prepare-icons.cjs && npm run release:notices && electron-builder --dir --publish never",
        "dist": "npm run build && node scripts/prepare-icons.cjs && npm run release:notices && electron-builder --publish never",
        "dist:win": "npm run build && node scripts/prepare-icons.cjs && npm run release:notices && electron-builder --win nsis --x64 --publish never && npm run release:checksums",
        "dist:win:signed": "npm run build && node scripts/prepare-icons.cjs && npm run release:notices && electron-builder --win nsis --x64 --publish never --config.forceCodeSigning=true && npm run release:checksums",
        "release:notices": "node scripts/third-party-notices.cjs",
        "release:checksums": "node scripts/release-checksums.cjs",
        "security:audit": "node scripts/audit-production.cjs",
        "qa:transfer": "node scripts/release-smoke.mjs --transfer-only",
        "qa:release": "npm run build && node scripts/release-smoke.mjs",
        "postinstall": "node node_modules/electron/install.js && npm rebuild node-datachannel && electron-rebuild"
    },
    "keywords": [
        "bittorrent",
        "torrent",
        "desktop",
        "electron"
    ],
    "author": "Contribuidores do Meshy Torrent",
    "homepage": "https://github.com/leandrolsouza/meshy-torrent#readme",
    "repository": {
        "type": "git",
        "url": "https://github.com/leandrolsouza/meshy-torrent.git"
    },
    "bugs": {
        "url": "https://github.com/leandrolsouza/meshy-torrent/issues"
    },
    "license": "MIT",
    "dependencies": {
        "electron-log": "^5.4.4",
        "electron-store": "^11.0.2",
        "electron-updater": "^6.8.10",
        "js-yaml": "^4.3.2",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "react-icons": "^5.7.0",
        "react-intl": "^12.1.4",
        "webtorrent": "^3.0.21",
        "zustand": "^5.0.15"
    },
    "devDependencies": {
        "@babel/plugin-transform-modules-commonjs": "^7.29.7",
        "@electron/rebuild": "^4.2.1",
        "@eslint/js": "^10.0.1",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@types/jest": "^30.0.0",
        "@types/js-yaml": "^4.0.9",
        "@types/node": "^26.6.4",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@types/webtorrent": "^3.0.0",
        "@typescript/native": "npm:typescript@~7.0.2",
        "@vitejs/plugin-react": "^5.2.0",
        "babel-jest": "^30.5.2",
        "electron": "^44.7.0",
        "electron-builder": "^26.15.3",
        "electron-vite": "^5.0.0",
        "eslint": "^10.12.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react-hooks": "^7.1.1",
        "fast-check": "^4.10.2",
        "identity-obj-proxy": "^3.0.0",
        "jest": "^30.5.2",
        "jest-environment-jsdom": "^30.5.2",
        "prettier": "^3.9.9",
        "ts-jest": "^29.4.14",
        "typescript": "npm:@typescript/typescript6@~6.0.2",
        "typescript-eslint": "^8.71.1",
        "vite": "^7.3.7"
    },
    "allowScripts": {
        "electron@44.7.0": true,
        "bufferutil@4.1.0": true,
        "esbuild@0.25.12": true,
        "esbuild@0.27.7": true,
        "node-datachannel@0.32.3": true,
        "utf-8-validate@6.0.6": true,
        "utp-native@2.5.3": true
    }
}
